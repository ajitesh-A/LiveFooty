# Optional: free API key from https://www.football-data.org (free tier = 10 req/min)
# Enables official score/fixture data for ALL leagues (EPL, La Liga, Serie A,
# Bundesliga, Ligue 1, Champions League). Without it:
#   - Bundesliga comes from openLigaDB (official, keyless)
#   - other leagues come from TheSportsDB (aggregated)
#   - any league with no data uses generated fixtures as fallback
FOOTBALL_DATA_API_KEY=

# Optional: API key from https://resend.com (free tier: 3000 emails/month)
# Enables real email verification codes. Without it, codes are logged to
# backend/data/dev-mail.log and the server console (dev mode).
RESEND_API_KEY=
MAIL_FROM=LiveFooty <onboarding@resend.dev>